{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AthenaQueries",
      "Effect": "Allow",
      "Action": ["athena:StartQueryExecution", "athena:GetQueryExecution",
                 "athena:GetQueryResults", "athena:StopQueryExecution",
                 "athena:GetWorkGroup"],
      "Resource": "*"
    },
    {
      "Sid": "GlueCatalog",
      "Effect": "Allow",
      "Action": ["glue:GetDatabase", "glue:GetDatabases", "glue:GetTable",
                 "glue:GetTables", "glue:GetPartitions", "glue:CreateTable",
                 "glue:UpdateTable", "glue:DeleteTable", "glue:CreateDatabase",
                 "glue:BatchCreatePartition", "glue:GetPartition"],
      "Resource": "*"
    },
    {
      "Sid": "S3LakeAccess",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject",
                 "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::YOUR_BUCKET",
                   "arn:aws:s3:::YOUR_BUCKET/*"]
    },
    {
      "Sid": "Alerting",
      "Effect": "Allow",
      "Action": ["sns:Publish"],
      "Resource": "arn:aws:sns:us-west-2:*:market-pulse-alerts"
    }
  ]
}
