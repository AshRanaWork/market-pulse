{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteRawData",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET/raw/*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream",
                 "logs:PutLogEvents"],
      "Resource": "*"
    }
  ]
}
